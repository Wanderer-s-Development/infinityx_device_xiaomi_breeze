hal_client_domain(platform_app, vendor_hal_camerapostproc_xiaomi)
hal_client_domain(platform_app_36, vendor_hal_camerapostproc_xiaomi)

binder_use(platform_app)
binder_use(platform_app_36)

binder_call(platform_app, vendor_hal_camerapostproc_xiaomi)
binder_call(platform_app_36, vendor_hal_camerapostproc_xiaomi)

binder_call(platform_app, vendor_hal_soter_qti)
binder_call(platform_app_36, vendor_hal_soter_qti)

binder_call(platform_app, hal_camera_default)
binder_call(platform_app_36, hal_camera_default)

allow { platform_app platform_app_36 } hal_camera_default:fd use;
allow { platform_app platform_app_36 } adsprpcd_file:dir { open read search };
allow { platform_app platform_app_36 } vendor_xdsp_device:chr_file { ioctl open read write };
allow { platform_app platform_app_36 } vendor_qdsp_device:chr_file { ioctl open read write };
allow { platform_app platform_app_36 } vendor_camera_data_file:dir create_dir_perms;
allow { platform_app platform_app_36 } vendor_camera_data_file:file create_file_perms;
allow { platform_app platform_app_36 } vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow { platform_app platform_app_36 } vendor_hal_soter_hwservice:hwservice_manager { find };
allow { platform_app platform_app_36 } app_data_file:file { execute };

# Properties
allow { platform_app platform_app_36 } vendor_display_prop:file read;
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app_36, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_panel_info_prop)
get_prop(platform_app_36, vendor_panel_info_prop)
