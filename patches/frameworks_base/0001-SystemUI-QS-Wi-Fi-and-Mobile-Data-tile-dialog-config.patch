diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/impl/wifi/domain/interactor/WifiTileUserActionInteractor.kt b/packages/SystemUI/src/com/android/systemui/qs/tiles/impl/wifi/domain/interactor/WifiTileUserActionInteractor.kt
index 96039b07c..cddfe4c70 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/tiles/impl/wifi/domain/interactor/WifiTileUserActionInteractor.kt
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/impl/wifi/domain/interactor/WifiTileUserActionInteractor.kt
@@ -16,7 +16,9 @@
 
 package com.android.systemui.qs.tiles.impl.wifi.domain.interactor
 
+import android.content.Context
 import android.content.Intent
+import android.os.UserHandle
 import android.provider.Settings
 import com.android.systemui.animation.Expandable
 import com.android.systemui.dagger.qualifiers.Main
@@ -37,6 +39,7 @@ import kotlinx.coroutines.withContext
 class WifiTileUserActionInteractor
 @Inject
 constructor(
+    private val context: Context,
     @Main private val mainContext: CoroutineContext,
     private val internetDialogManager: InternetDialogManager,
     private val accessPointController: AccessPointController,
@@ -61,6 +64,22 @@ constructor(
         }
 
     suspend fun handleClick(expandable: Expandable?) {
+        val showDialog =
+            Settings.System.getIntForUser(
+                context.contentResolver,
+                Settings.System.QS_WIFI_SHOW_DIALOG,
+                0,
+                UserHandle.USER_CURRENT,
+            ) != 0
+
+        if (showDialog) {
+            showDialog(expandable)
+        } else {
+            handleSecondaryClick(expandable)
+        }
+    }
+
+    suspend fun showDialog(expandable: Expandable?) {
         withContext(mainContext) {
             internetDialogManager.create(
                 aboveStatusBar = true,
